NODE_ENV=development
PORT=8081
HOST=0.0.0.0
PUBLIC_BASE_URL=https://calls.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=cloudcomai
JWT_AUDIENCE=cloudcomai-calling
JWT_USER_ID_CLAIM=sub
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cloudcomai_calls
MYSQL_USER=calling_service
MYSQL_PASSWORD=replace-me
MYSQL_CONNECTION_LIMIT=5
MYSQL_ROOT_PASSWORD=replace-me-too
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=REPLACE_WITH_PUBLIC_IP
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
MEDIASOUP_NUM_WORKERS=1
TURN_HOST=calls.example.com
TURN_UDP_PORT=3478
TURN_TLS_PORT=5349
TURN_SECRET=replace-with-a-different-long-random-secret-at-least-32-chars
TURN_REALM=calls.example.com
CALL_RING_TIMEOUT_SECONDS=45
CALL_RECONNECT_GRACE_SECONDS=20
LOG_LEVEL=info
